APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The backend serves on 8000; the Next.js site is the one on 3000.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sansekai_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
# Leave unset locally (plain HTTP); set true wherever the panel is on HTTPS.
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes emails to storage/logs/laravel.log instead of sending them.
# Production sends through Brevo, already verified for sansekaisolution.com
# (the brevo1/brevo2 DKIM records in the DNS): Brevo → SMTP & API → SMTP keys.
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<the SMTP login Brevo shows, e.g. 9a1b2c001@smtp-brevo.com>
#   MAIL_PASSWORD=<the SMTP key>
#   MAIL_FROM_ADDRESS="notifications@sansekaisolution.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Who gets an email when a website form lands a lead. Comma-separated; empty
# sends nothing. The email's button opens BACK_OFFICE_URL/leads?lead={id}.
LEAD_NOTIFICATION_EMAIL=
BACK_OFFICE_URL=https://sansekaisolution.com/admin

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin account created by AdminUserSeeder (php artisan db:seed).
# Leave ADMIN_PASSWORD blank and the seeder generates one and prints it once,
# in local only; outside local it refuses to seed until you set a real value.
# Setting it and re-seeding also resets an existing account password.
ADMIN_NAME="Sansekai Admin"
# The administrator's login. The email is the only identifier — the Filament
# panel and the API token endpoint both sign in with it.
ADMIN_EMAIL=admin@sansekaisolution.com
ADMIN_PASSWORD=

# Force every admin through authenticator-app setup before reaching the panel.
ADMIN_REQUIRE_MFA=false


# Disk for uploaded documents. Must stay private — nothing here is served from
# public storage, so a Kbis cannot be reached by guessing a URL.
LEAD_DOCUMENTS_DISK=lead_documents
