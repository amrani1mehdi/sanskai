
# --- CRM back office --------------------------------------------------------
# Where the Laravel API lives. Server-side only — no NEXT_PUBLIC_ prefix, or the
# browser could read it.
#
# Hostinger VPS — what the back office talks to by default. HTTPS on purpose:
# the host 301-redirects plain HTTP, and fetch turns a redirected POST into a
# GET without its body, which would silently break login and every write.
CRM_API_URL=https://api.sansekai.72-60-190-211.sslip.io/api

# Local backend instead (cd backend && php artisan serve):
# CRM_API_URL=http://localhost:8000/api

# Shared secret sent as X-Api-Key when the financing form submits a lead.
# Must match WEBSITE_API_KEY in the backend's own .env — it is the same secret,
# named for each side. Server-side only: never prefix it with NEXT_PUBLIC_, or
# the browser could read it and write leads to the CRM directly.
CRM_API_KEY=
