# Optional. Without it the landing page uses CoinGecko's public rate limit,
# which is fine for local development but thin for production traffic.
# Get a free demo key at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Laravel backend that /admin and the Filament assets are proxied to.
# Defaults to http://127.0.0.1:8000 when unset.
BACKEND_URL=http://127.0.0.1:8000
